PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/wishdrop
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
PUBLIC_REVEAL_BASE_URL=http://localhost:3001/surprise
PUBLIC_API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:8081

# On a phone, set these to your PC LAN IP, e.g.
# PUBLIC_API_BASE_URL=http://10.89.137.76:3001
# PUBLIC_REVEAL_BASE_URL=http://10.89.137.76:3001/surprise

# Optional — enable when ready
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# EXPO_ACCESS_TOKEN=
